+try:
+    from pointnet2_ops import pointnet2_utils
+
+    def fps(data, number):
+        '''
+            data B N 3
+            number int
+        '''
+        fps_idx = pointnet2_utils.furthest_point_sample(data, number)
+        fps_data = pointnet2_utils.gather_operation(data.transpose(1, 2).contiguous(), fps_idx).transpose(1, 2).contiguous()
+        return fps_data
+except Exception:  # pointnet2_ops (CUDA ext) unavailable — pure-PyTorch FPS.
+    # Deterministic farthest-point sampling seeded at index 0, matching the
+    # pointnet2 CUDA kernel's default first pick, so gallery embeddings built
+    # here are identical to those from a machine that has the CUDA op.
+    def fps(data, number):
+        '''
+            data B N 3  (or B N C, sampling on first 3 dims' geometry)
+            number int
+        '''
+        B, N, C = data.shape
+        device = data.device
+        centroids = torch.zeros(B, number, dtype=torch.long, device=device)
+        distance = torch.full((B, N), 1e10, device=device)
+        farthest = torch.zeros(B, dtype=torch.long, device=device)
+        batch_indices = torch.arange(B, dtype=torch.long, device=device)
+        for i in range(number):
+            centroids[:, i] = farthest
+            centroid = data[batch_indices, farthest, :].view(B, 1, C)
+            dist = torch.sum((data - centroid) ** 2, dim=-1)
+            mask = dist < distance
+            distance[mask] = dist[mask]
+            farthest = torch.max(distance, dim=-1)[1]
+        return torch.gather(
+            data, 1, centroids.unsqueeze(-1).expand(-1, -1, C))
 
