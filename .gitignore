# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/

# OS/Editor artifacts
.DS_Store
Thumbs.db
*:Zone.Identifier

# Large datasets and generated assets
/eval/datasets/
/object_database/
/object_images/
rendering/blender-*/
blender-*/
*.zip
*.tar
*.tar.gz

# Optional local outputs
/results/

# Per-run evaluation outputs (can be GB-scale)
/object_retrieval/results_*/
/object_retrieval/top*_rankings_*.json
/debug_output/

# Pre-computed ULIP query caches (27 MB+ per dataset)
/object_retrieval/ulip_query_cache_*.pt

# Keep empty directory placeholders if needed
!/eval/datasets/.gitkeep
!/object_database/.gitkeep
!/object_images/.gitkeep
!/results/.gitkeep

# Official SHREC18 eval kit (clone of hkust-vgd/shrec18)
/eval/shrec18_official/

# Duty-cycle / long-run logs
/logs/
/.onboard_done_*.txt

# Stage-3: vendored external deps (reproducible, see third_party/SETUP.md)
third_party/bop_toolkit/
third_party/pylibs/

# dGeDi descriptor caches — 6.8 GB across the four galleries (2026-08-31).
# These were untracked but NOT ignored; a `git add -A` would have tried to
# commit all of it. Regenerable via tools/precompute_gedi_descriptors.py.
/object_retrieval/.dgedi_gallery*/

# Query-embedding dumps from the ULIP/Uni3D comparison runs
/object_retrieval/rq_*/

# Accidental nested copy (wrong cwd during a container run)
/object_retrieval/object_retrieval/

# Scratch at the repo root: ad-hoc run logs, status files and probes
/_*.log
/_*.sh
/_*.status
/scratch_*.py

# Stage-4 work directory (renders/clouds written outside object_images/)
/.stage4_work/

# Grasping demo renders (regenerable via grasping/stage5_demo.py)
/grasping/*.png
/grasping/demo_grasps.json

# Beiseitegeraeumte Full-Mesh-Caches (regenerierbar)
/.ulip_cache_stash_*/

# Stage-4-Messergebnisse
/results_stage4/
